# Makefile for single batch

BATCHNO=B
OUT=out
PROBLEMS=../problems
GRAPHICS=graphics# graphics for the leaflet
PGRAPHICS=$(PROBLEMS)/graphics# graphics for problems

ARG_CS=\def\mdeadline{${DEADLINE_CS[${BATCHNO}]}}\def\mdeadlineS{${DEADLINE_CS_POST[${BATCHNO}]}}
ARG_EN=\def\mdeadline{${DEADLINE_EN[${BATCHNO}]}}\def\mdeadlineS{${DEADLINE_EN_POST[${BATCHNO}]}}

.SUFFIXES:
.PHONY: all clean cleanall web book

# == Main targets ==
all: web book
include ../Makefile.inc
web: $(OUT)/leaflet$(BATCHNO).cs.pdf $(OUT)/leaflet$(BATCHNO).en.pdf
book: $(OUT)/leaflet$(BATCHNO)-book.cs.pdf $(OUT)/leaflet$(BATCHNO)-book.en.pdf

# == problem and graphics dependence ==
DEPS_PROBS= $(wildcard $(PROBLEMS)/problem$(BATCHNO)*) $(call graphics-deps,$(PGRAPHICS),$(BATCHNO)-)
DEPS_GRAPHICS_LEAFLET = $(call graphics-deps,$(GRAPHICS))
DEPS_GRAPHICS_MANUAL= graphics/matfyz.pdf

SERIEDEP=\
	$(DEPS_PROBS) $(DEPS_GRAPHICS_LEAFLET) $(DEPS_GRAPHICS_MANUAL)\
	../Deadline.inc

$(OUT)/leaflet$(BATCHNO).cs.pdf: leaflet$(BATCHNO).cs.tex $(SERIEDEP) | $(OUT)
	$(call XELATEX,'\def\UseOption{web}$(ARG_CS)\input{$<}')
$(OUT)/leaflet$(BATCHNO).en.pdf: leaflet$(BATCHNO).en.tex $(SERIEDEP) | $(OUT)
	$(call XELATEX,'\def\UseOption{web}$(ARG_EN)\input{$<}')

$(OUT)/leaflet$(BATCHNO)-print.cs.pdf: leaflet$(BATCHNO).cs.tex $(SERIEDEP) | $(OUT)
	$(call XELATEX,'\def\classoptions{twoside}\def\UseOption{print}$(ARG_CS)\input{$<}')
$(OUT)/leaflet$(BATCHNO)-print.en.pdf: leaflet$(BATCHNO).en.tex $(SERIEDEP) | $(OUT)
	$(call XELATEX,'\def\classoptions{twoside}\def\UseOption{print}$(ARG_EN)\input{$<}')

$(OUT)/leaflet$(BATCHNO)-book.%.pdf: $(OUT)/leaflet$(BATCHNO)-print.%.pdf | $(OUT)
	pdfbook --booklet true --outfile '$@' $<

clean:
	find $(OUT) -type f -not \( -name "*.pdf" -o -name ".*" \) | xargs rm

cleanall:
	rm $(OUT)/*
#	ls $(GRAPHICS) $(PGRAPHICS) | grep -v '\(mp\|plt\|eps\|jpg\|png\)$$' | xargs rm
